{
  "name": "jewellery-system-arnav",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:master-prices": "node --test tests/masterPrices.test.mjs",
    "test:master-prices:rules": "node --test tests/masterPriceRules.test.mjs",
    "test:dimensions": "node --test tests/dimensions.test.mjs",
    "test:dimensions:rules": "node --test tests/dimensionRules.test.mjs",
    "audit:dimensions": "node scripts/auditDimensions.mjs",
    "setup:inventory-identities": "node scripts/initializeInventoryIdentities.mjs",
    "test:identity-rollout": "node --test tests/identityRollout.test.mjs",
    "test:identity-cli": "node --test tests/identityRolloutCli.test.mjs",
    "test:numbers": "node --test tests/documentNumbers.test.mjs",
    "test:purchase": "node --test tests/purchaseValidation.test.mjs",
    "test:rules": "node --test tests/numberingRules.test.mjs",
    "test:ui": "playwright test --config tests/playwright.config.mjs",
    "test:numbering:local": "npm run test:numbers && npm run test:rules && npm run test:ui",
    "test:numbering": "firebase emulators:exec --only firestore --project demo-jewellery-numbering --config firebase.test.json \"npm run test:numbering:local\"",
    "verify:inventory": "node scripts/verifyInventoryContract.mjs",
    "prebuild": "npm run verify:inventory",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:discovery": "node --test tests/inventoryDiscovery.test.mjs",
    "dev:local": "vite --mode emulator"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@google-cloud/firestore": "^9.2.0",
    "@playwright/test": "^1.63.0",
    "@types/prettier": "^2.7.3",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-admin": "^14.5.0",
    "globals": "^17.11.0",
    "google-auth-library": "^11.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  }
}
