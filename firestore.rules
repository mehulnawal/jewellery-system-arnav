rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // The UI and database both identify administrators by their real employee profile role.
    function admin() { return signedIn() && (request.auth.uid == 'rK6ZhxFiauVodjzbssviy5sUyP03' || profile().role == 'superadmin'); }
    function profile() { return get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data; }
    function activeEmployee() { return signedIn() && profile().active == true; }
    function graceEmployee() { return signedIn() && profile().active == false && profile().accessRevokedAt is timestamp && request.time < profile().accessRevokedAt + duration.value(2, "m"); }
    function activeOrGraceEmployee() { return activeEmployee() || graceEmployee(); }
    function authenticActor() { return request.resource.data.actor.uid == request.auth.uid && request.resource.data.actor.accessId == profile().accessId && request.resource.data.actor.role == profile().role; }
    function inventoryEmployee() { return activeOrGraceEmployee() && profile().permissions.hasAny(['inventory']); }
    function challanStageOneEmployee() { return activeOrGraceEmployee() && profile().permissions.hasAny(['challan-stage-1']); }
    function challanEmployee() { return activeOrGraceEmployee() && profile().permissions.hasAny(['challan-stage-1', 'challan-stage-2', 'challan-stage-3', 'challan-stage-4']); }
    function purchaseEmployee() { return activeOrGraceEmployee() && profile().permissions.hasAny(['purchase']); }
    match /employeeProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin() || (request.auth.uid == 'rK6ZhxFiauVodjzbssviy5sUyP03' && request.auth.uid == uid && request.resource.data.role == 'superadmin');
      allow list, update, delete: if admin();
    }
    // Recoverable staff credentials are deliberately isolated from staff profiles.
    match /staffCredentials/{uid} {
      allow read, create, update, delete: if admin();
    }
    match /inventory/{entry} {
      // Check Inventory is a read-only stock lookup available to every active staff account.
      allow read: if admin() || activeOrGraceEmployee();
      allow create: if admin() || (inventoryEmployee() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time) || (purchaseEmployee() && request.resource.data.sourcePurchaseId is string && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time);
      // Staff can update their own server-timestamped inventory entry for two minutes.
      // Creation ownership/timing fields cannot be changed to extend that window.
      allow update: if admin() || (inventoryEmployee() && resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(2, "m") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt) || (purchaseEmployee() && resource.data.sourcePurchaseId is string && resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(10, "m") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt) || (challanStageOneEmployee() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["weight", "pieces", "updatedAt"]) && request.resource.data.weight is number && request.resource.data.weight >= 0 && request.resource.data.weight <= resource.data.weight && request.resource.data.pieces is number && request.resource.data.pieces >= 0 && request.resource.data.pieces <= resource.data.pieces);
      allow delete: if admin();
    }
    match /shapes/{entry} { allow read: if activeOrGraceEmployee() || admin(); allow write: if admin() || inventoryEmployee(); }
    match /settings/{entry} { allow read: if activeEmployee() || admin(); allow write: if admin(); }
    match /parties/{party} {
      allow read: if activeOrGraceEmployee() || admin();
      allow create: if admin() || activeOrGraceEmployee();
      allow update, delete: if admin();
    }
    match /challans/{entry} {
      allow read, create: if admin() || challanEmployee();
      // Staff may only edit their own Challan during its server-timestamped 60-minute window.
      // Stage-only updates remain available for the normal Challan workflow.
      allow update: if admin() || (activeOrGraceEmployee() && ((resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(60, "m") && ((resource.data.stage == 1 && profile().permissions.hasAny(['challan-stage-1'])) || (resource.data.stage == 2 && profile().permissions.hasAny(['challan-stage-2'])) || (resource.data.stage == 3 && profile().permissions.hasAny(['challan-stage-3'])) || (resource.data.stage == 4 && profile().permissions.hasAny(['challan-stage-4'])))) || (resource.data.stage == 1 && request.resource.data.stage == 2 && profile().permissions.hasAny(['challan-stage-2']) && request.resource.data.stage2Return.items is list && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stage", "stage2Return", "stageHistory"])) || (resource.data.stage == 2 && request.resource.data.stage == 3 && profile().permissions.hasAny(['challan-stage-3']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stage", "finalInvoice", "stageHistory"])) || (resource.data.stage == 3 && request.resource.data.stage == 4 && profile().permissions.hasAny(['challan-stage-4']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stage", "finalSettlement", "stageHistory"]))));
      allow delete: if admin();
    }
    match /purchases/{entry} {
      allow read: if admin() || purchaseEmployee();
      allow create: if admin() || (purchaseEmployee() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time);
      allow update: if admin() || (purchaseEmployee() && resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(10, "m") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if admin();
    }
    match /vendors/{entry} { allow read: if admin() || purchaseEmployee(); allow create, update: if admin() || purchaseEmployee(); allow delete: if admin(); }
    match /brokers/{entry} { allow read: if admin() || purchaseEmployee(); allow create, update: if admin() || purchaseEmployee(); allow delete: if admin(); }
    match /counters/{entry} { allow read: if admin() || purchaseEmployee(); allow create, update: if admin() || purchaseEmployee(); allow delete: if false; }
    match /activityLog/{entry} { allow read: if admin(); allow create: if admin() || (activeOrGraceEmployee() && authenticActor()); allow update, delete: if false; }
    match /activityLogFirstLogins/{entry} { allow read: if admin(); allow create: if admin() || (activeOrGraceEmployee() && authenticActor()); allow update, delete: if false; }
  }
}
