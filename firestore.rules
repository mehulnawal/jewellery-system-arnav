rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function businessUnlocked() { return !exists(/databases/$(database)/documents/systemState/business) || get(/databases/$(database)/documents/systemState/business).data.locked == false; }
    function currentBusinessGeneration() { return !exists(/databases/$(database)/documents/systemState/business) || get(/databases/$(database)/documents/systemState/business).data.get('generation', 0) == 0 || request.resource.data.get('businessGeneration', -1) == get(/databases/$(database)/documents/systemState/business).data.generation; }
    match /systemState/{id} { allow read: if request.auth != null; allow write: if false; }
    match /businessResetAudits/{id} { allow read: if admin(); allow write: if false; }
    match /resetAuthorizations/{id} { allow read, write: if false; }
    function signedIn() { return request.auth != null; }
    // The UI and database both identify administrators by their real employee profile role.
    function admin() { return signedIn() && (request.auth.uid == 'rK6ZhxFiauVodjzbssviy5sUyP03' || profile().role == 'superadmin'); }
    function profile() { return get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data; }
    function activeEmployee() { return signedIn() && profile().active == true; }
    function graceEmployee() { return signedIn() && profile().active == false && profile().accessRevokedAt is timestamp && request.time < profile().accessRevokedAt + duration.value(2, "m"); }
    function activeOrGraceEmployee() { return activeEmployee() || graceEmployee(); }
    function authenticActor() { return request.resource.data.actor.uid == request.auth.uid && request.resource.data.actor.accessId == profile().accessId && request.resource.data.actor.role == profile().role; }
    function inventoryEmployee() { return activeOrGraceEmployee() && profile().permissions.hasAny(['inventory']); }
    function challanStageOneEmployee() { return activeOrGraceEmployee() && profile().permissions.hasAny(['challan-stage-1']); }
    function challanEmployee() { return activeOrGraceEmployee() && profile().permissions.hasAny(['challan-stage-1', 'challan-stage-2', 'challan-stage-3', 'challan-stage-4']); }
    function purchaseEmployee() { return activeOrGraceEmployee() && profile().permissions.hasAny(['purchase']); }
    function numberingReady() {
      let marker = /databases/$(database)/documents/numberingMigrations/manual-v1;
      return exists(marker) && get(marker).data.ready == true;
    }
    function lettersReady() {
      let marker = /databases/$(database)/documents/numberingMigrations/letters-v1;
      return exists(marker) && get(marker).data.ready == true;
    }
    function validChallanNumber(value) {
      return value is string && value.matches('[A-Z][0-9]+/([1-9]|[1-9][0-9]|100)');
    }
    function validPurchaseNumber(value) {
      return value is string && value.matches('PR-[A-Z][0-9]+-([1-9]|[1-9][0-9]|100)');
    }
    function claimedChallanNumber(entry) {
      let number = request.resource.data.number;
      let key = number.replace('/', '-');
      return validChallanNumber(number) && numberingReady()
        && (number.matches('A.*') || lettersReady())
        && getAfter(/databases/$(database)/documents/challanNumbers/$(key)).data.recordId == entry
        && getAfter(/databases/$(database)/documents/challanNumbers/$(key)).data.number == number;
    }
    function claimedPurchaseNumber(entry) {
      let number = request.resource.data.purchaseId;
      return validPurchaseNumber(number) && numberingReady()
        && (number.matches('PR-A.*') || lettersReady())
        && getAfter(/databases/$(database)/documents/purchaseNumbers/$(number)).data.recordId == entry
        && getAfter(/databases/$(database)/documents/purchaseNumbers/$(number)).data.number == number;
    }
    function validPurchaseFields(entry) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'purchaseId', 'date', 'vendorName', 'totalWeight', 'amount', 'discount', 'discountAmount', 'netPayable', 'paymentDueDays', 'paymentDueDate', 'items', 'itemCount'])
        && data.id == entry
        && data.purchaseId is string
        && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.vendorName is string && data.vendorName.size() > 0
        && data.get('brokerName', '') is string
        && data.totalWeight is number && data.totalWeight > 0
        && data.amount is number && data.amount > 0
        && data.discount is number && data.discount >= 0 && data.discount <= 100
        && data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= data.amount
        && data.netPayable is number && data.netPayable >= 0 && data.netPayable <= data.amount
        && data.paymentDueDays is int && data.paymentDueDays >= 0
        && data.paymentDueDate is string && data.paymentDueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.items is list && data.items.size() > 0
        && data.itemCount == data.items.size();
    }
    match /numberingMigrations/{entry} {
      allow read: if admin() || challanEmployee() || purchaseEmployee();
      // An Admin completes the one-time index from Settings on the free plan.
      allow create, update: if businessUnlocked() && (entry in ['manual-v1', 'letters-v1'] && admin()
        && request.resource.data.keys().hasOnly(['ready', 'completedAt'])
        && request.resource.data.ready == true);
      allow delete: if businessUnlocked() && (false);
    }
    match /challanNumbers/{key} {
      allow read: if admin() || challanEmployee();
      allow create: if businessUnlocked() && (admin() && (!numberingReady() || (!lettersReady() && !request.resource.data.number.matches('A.*')))
        && request.resource.data.keys().hasOnly(['number', 'recordId', 'legacyRecordIds'])
        && validChallanNumber(request.resource.data.number)
        && key == request.resource.data.number.replace('/', '-')
        && (request.resource.data.recordId is string || request.resource.data.recordId == null)
        || (admin() || challanEmployee()) && numberingReady()
        && (request.resource.data.number.matches('A.*') || lettersReady())
        && request.resource.data.keys().hasOnly(['number', 'recordId'])
        && validChallanNumber(request.resource.data.number)
        && key == request.resource.data.number.replace('/', '-')
        && request.resource.data.recordId is string
        && getAfter(/databases/$(database)/documents/challans/$(request.resource.data.recordId)).data.number == request.resource.data.number);
      allow update: if businessUnlocked() && (admin() && (!numberingReady() || (!lettersReady() && !request.resource.data.number.matches('A.*')))
        && request.resource.data.keys().hasOnly(['number', 'recordId', 'legacyRecordIds'])
        && validChallanNumber(request.resource.data.number)
        && key == request.resource.data.number.replace('/', '-'));
      allow delete: if businessUnlocked() && (admin() && resource.data.recordId is string
        && (!existsAfter(/databases/$(database)/documents/challans/$(resource.data.recordId))
          || getAfter(/databases/$(database)/documents/challans/$(resource.data.recordId)).data.number != resource.data.number));
    }
    match /purchaseNumbers/{key} {
      allow read: if admin() || purchaseEmployee();
      allow create: if businessUnlocked() && (admin() && (!numberingReady() || (!lettersReady() && !request.resource.data.number.matches('PR-A.*')))
        && request.resource.data.keys().hasOnly(['number', 'recordId', 'legacyRecordIds'])
        && validPurchaseNumber(request.resource.data.number)
        && key == request.resource.data.number
        && (request.resource.data.recordId is string || request.resource.data.recordId == null)
        || (admin() || purchaseEmployee()) && numberingReady()
        && (request.resource.data.number.matches('PR-A.*') || lettersReady())
        && request.resource.data.keys().hasOnly(['number', 'recordId'])
        && validPurchaseNumber(request.resource.data.number)
        && key == request.resource.data.number
        && request.resource.data.recordId is string
        && getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.recordId)).data.purchaseId == request.resource.data.number);
      allow update: if businessUnlocked() && (admin() && (!numberingReady() || (!lettersReady() && !request.resource.data.number.matches('PR-A.*')))
        && request.resource.data.keys().hasOnly(['number', 'recordId', 'legacyRecordIds'])
        && validPurchaseNumber(request.resource.data.number)
        && key == request.resource.data.number);
      allow delete: if businessUnlocked() && (admin() && resource.data.recordId is string
        && !existsAfter(/databases/$(database)/documents/purchases/$(resource.data.recordId)));
    }
    match /employeeProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin() || (request.auth.uid == 'rK6ZhxFiauVodjzbssviy5sUyP03' && request.auth.uid == uid && request.resource.data.role == 'superadmin');
      allow list, update, delete: if admin();
    }
    // Recoverable staff credentials are deliberately isolated from staff profiles.
    match /staffCredentials/{uid} {
      allow read, create, update, delete: if admin();
    }
    // Canonical decimal text: no leading zeros, no trailing fractional zeros,
    // positive components only. This validates the shared JS utility's output.
    function canonicalSize(value) {
      return value is string
        && value.matches('([1-9][0-9]*|([1-9][0-9]*|0)[.][0-9]*[1-9])(X([1-9][0-9]*|([1-9][0-9]*|0)[.][0-9]*[1-9]))?');
    }
    function identityReady() {
      return exists(/databases/$(database)/documents/inventoryIdentityMigrations/v1)
        && get(/databases/$(database)/documents/inventoryIdentityMigrations/v1).data.ready == true;
    }
    function identitySetupInProgress() {
      return exists(/databases/$(database)/documents/inventoryIdentityMigrations/v1)
        && get(/databases/$(database)/documents/inventoryIdentityMigrations/v1).data.get('status', '') == 'initializing';
    }
    function validIdentityPart(value) {
      return value is string
        && value.matches('[^/_[:space:][:cntrl:]]([^/_[:cntrl:]]*[^/_[:space:][:cntrl:]])?');
    }
    function inventoryIdentityChanged(entry) {
      let path = /databases/$(database)/documents/inventory/$(entry);
      return !exists(path)
        || getAfter(path).data.diff(get(path).data).affectedKeys().hasAny(['size', 'shape', 'type', 'sku']);
    }
    function claimedInventoryIdentity(entry) {
      let data = request.resource.data;
      return identityReady() && canonicalSize(data.size) && validIdentityPart(data.shape) && validIdentityPart(data.type)
        && data.sku == data.size + '_' + data.shape + '_' + data.type
        && getAfter(/databases/$(database)/documents/inventoryIdentities/$(data.sku)).data.recordId == entry;
    }
    function validMasterPrice(key) {
      let data = request.resource.data;
      return data.keys().hasOnly(['type', 'shape', 'height', 'width', 'price', 'active', 'revision', 'createdAt', 'updatedAt', 'updatedBy', 'businessGeneration'])
        && validIdentityPart(data.type) && validIdentityPart(data.shape)
        && canonicalSize(data.height)
        && (data.width == '' || (canonicalSize(data.width) && !data.width.matches('.*X.*')))
        && key == data.height + '_' + data.shape + '_' + data.type + '__' + (data.width == '' ? 'default' : data.width)
        && data.price is number && data.price > 0 && data.price - data.price == 0
        && data.active is bool && data.revision is int
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    match /masterPrices/{key} {
      allow read: if admin() || (challanEmployee() && resource.data.active == true);
      allow create: if businessUnlocked() && currentBusinessGeneration() && (admin() && validMasterPrice(key) && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time);
      allow update: if businessUnlocked() && currentBusinessGeneration() && (admin() && validMasterPrice(key)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1);
      // Deactivation retains the record; Activity Log retains each mutation snapshot.
      allow delete: if businessUnlocked() && (false);
    }
    match /inventoryIdentityMigrations/{entry} {
      allow read: if admin() || activeOrGraceEmployee();
      // Only a trusted Admin SDK rollout may initialize the audited index.
      allow write: if businessUnlocked() && (false);
    }
    match /inventoryIdentities/{key} {
      allow read: if admin() || activeOrGraceEmployee();
      allow create, update: if businessUnlocked() && ((admin() || inventoryEmployee() || purchaseEmployee())
        && identityReady()
        && request.resource.data.keys().hasOnly(['sku', 'recordId'])
        && request.resource.data.sku == key
        && request.resource.data.recordId is string
        // A reservation is only an accompaniment to an authorized stock identity
        // transition. Staff cannot independently edit or initialize the registry.
        && inventoryIdentityChanged(request.resource.data.recordId)
        && canonicalSize(getAfter(/databases/$(database)/documents/inventory/$(request.resource.data.recordId)).data.size)
        && getAfter(/databases/$(database)/documents/inventory/$(request.resource.data.recordId)).data.sku == key
        && (!exists(/databases/$(database)/documents/inventoryIdentities/$(key))
          || resource.data.recordId == request.resource.data.recordId
          || (resource.data.recordId is string
            && (!existsAfter(/databases/$(database)/documents/inventory/$(resource.data.recordId))
              || (get(/databases/$(database)/documents/inventory/$(resource.data.recordId)).data.sku == key
                && getAfter(/databases/$(database)/documents/inventory/$(resource.data.recordId)).data.sku != key)))));
      allow delete: if businessUnlocked() && (identityReady() && (admin() || inventoryEmployee() || purchaseEmployee())
        && resource.data.recordId is string
        && exists(/databases/$(database)/documents/inventory/$(resource.data.recordId))
        && (!existsAfter(/databases/$(database)/documents/inventory/$(resource.data.recordId))
          || getAfter(/databases/$(database)/documents/inventory/$(resource.data.recordId)).data.diff(get(/databases/$(database)/documents/inventory/$(resource.data.recordId)).data).affectedKeys().hasAny(['size', 'shape', 'type'])));
    }
    match /inventory/{entry} {
      // Check Inventory is a read-only stock lookup available to every active staff account.
      allow read: if admin() || activeOrGraceEmployee();
      allow create: if businessUnlocked() && currentBusinessGeneration() && (claimedInventoryIdentity(entry) && (admin() || (inventoryEmployee() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time) || (purchaseEmployee() && request.resource.data.sourcePurchaseId is string && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time)));
      // Preserve the deployed 60-minute Inventory and 10-minute Purchase windows.
      // Creation ownership/timing fields cannot be changed to extend that window.
      allow update: if businessUnlocked() && currentBusinessGeneration() && ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(["size", "shape", "type", "sku"]) || claimedInventoryIdentity(entry)) && (admin() || (inventoryEmployee() && resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(60, "m") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt) || (purchaseEmployee() && resource.data.sourcePurchaseId is string && resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(10, "m") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt) || (challanStageOneEmployee() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["weight", "pieces", "updatedAt"]) && request.resource.data.weight is number && request.resource.data.weight >= 0 && request.resource.data.weight <= resource.data.weight && request.resource.data.pieces is number && request.resource.data.pieces >= 0 && (!resource.data.keys().hasAll(['pieces']) || request.resource.data.pieces <= resource.data.pieces))));
      allow delete: if businessUnlocked() && (!identitySetupInProgress() && (admin() || (inventoryEmployee() && resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(60, "m")) || (purchaseEmployee() && resource.data.sourcePurchaseId is string && resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(10, "m"))));
    }
    match /shapes/{entry} { allow read: if activeOrGraceEmployee() || admin(); allow write: if businessUnlocked() && (admin() || inventoryEmployee()); }
    match /settings/{entry} { allow read: if activeEmployee() || admin(); allow write: if businessUnlocked() && (admin()); }
    match /parties/{party} {
      allow read: if activeOrGraceEmployee() || admin();
      allow create: if businessUnlocked() && currentBusinessGeneration() && (admin() || activeOrGraceEmployee());
      allow update, delete: if businessUnlocked() && currentBusinessGeneration() && (admin());
    }
    match /challans/{entry} {
      allow read: if admin() || challanEmployee() || purchaseEmployee();
      allow create: if businessUnlocked() && currentBusinessGeneration() && ((admin() || challanStageOneEmployee()) && claimedChallanNumber(entry));
      // Staff may only edit their own Challan during its server-timestamped 60-minute window.
      // Stage-only updates remain available for the normal Challan workflow.
      allow update: if businessUnlocked() && currentBusinessGeneration() && ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['number']) || (admin() && claimedChallanNumber(entry)))
        && (admin() || (activeOrGraceEmployee() && ((resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(60, "m") && ((resource.data.stage == 1 && profile().permissions.hasAny(['challan-stage-1'])) || (resource.data.stage == 2 && profile().permissions.hasAny(['challan-stage-2'])) || (resource.data.stage == 3 && profile().permissions.hasAny(['challan-stage-3'])) || (resource.data.stage == 4 && profile().permissions.hasAny(['challan-stage-4'])))) || (resource.data.stage == 1 && request.resource.data.stage == 2 && profile().permissions.hasAny(['challan-stage-2']) && request.resource.data.stage2Return.items is list && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stage", "stage2Return", "stageHistory"])) || (resource.data.stage == 2 && request.resource.data.stage == 3 && profile().permissions.hasAny(['challan-stage-3']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stage", "finalInvoice", "stageHistory"])) || (resource.data.stage == 3 && request.resource.data.stage == 4 && profile().permissions.hasAny(['challan-stage-4']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stage", "finalSettlement", "stageHistory"])) ))));
      allow delete: if businessUnlocked() && (admin());
    }
    match /purchases/{entry} {
      allow read: if admin() || purchaseEmployee();
      allow create: if businessUnlocked() && currentBusinessGeneration() && (claimedPurchaseNumber(entry) && validPurchaseFields(entry) && (admin() || (purchaseEmployee() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time)));
      allow update: if businessUnlocked() && currentBusinessGeneration() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['purchaseId'])
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'updatedAt', 'updatedAtMs']) || validPurchaseFields(entry))
        && (admin() || (purchaseEmployee() && resource.data.createdBy == request.auth.uid && request.time < resource.data.createdAt + duration.value(10, "m") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt)));
      allow delete: if businessUnlocked() && (admin());
    }
    match /vendors/{entry} { allow read: if admin() || purchaseEmployee(); allow create, update: if businessUnlocked() && currentBusinessGeneration() && (admin() || purchaseEmployee()); allow delete: if businessUnlocked() && (admin()); }
    match /brokers/{entry} { allow read: if admin() || purchaseEmployee(); allow create, update: if businessUnlocked() && currentBusinessGeneration() && (admin() || purchaseEmployee()); allow delete: if businessUnlocked() && (admin()); }
    match /counters/{entry} { allow read: if admin() || purchaseEmployee(); allow create, update: if businessUnlocked() && currentBusinessGeneration() && (!(entry in ['challan', 'purchase']) && (admin() || purchaseEmployee())); allow delete: if businessUnlocked() && (false); }
    match /activityLog/{entry} { allow read: if admin(); allow create: if businessUnlocked() && currentBusinessGeneration() && (admin() || (activeOrGraceEmployee() && authenticActor() && request.resource.data.panel != 'master price list')); allow update, delete: if businessUnlocked() && currentBusinessGeneration() && (false); }
    match /activityLogFirstLogins/{entry} { allow get: if admin() || activeOrGraceEmployee(); allow list: if admin(); allow create: if businessUnlocked() && currentBusinessGeneration() && (admin() || (activeOrGraceEmployee() && authenticActor())); allow update, delete: if businessUnlocked() && currentBusinessGeneration() && (false); }
  }
}
