rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid == 'rK6ZhxFiauVodjzbssviy5sUyP03'; }
    function profile() { return get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data; }
    function activeEmployee() { return signedIn() && profile().active == true; }
    function inventoryEmployee() { return activeEmployee() && profile().permissions.hasAny(['inventory']); }
    match /employeeProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin() || (request.auth.uid == 'rK6ZhxFiauVodjzbssviy5sUyP03' && request.auth.uid == uid && request.resource.data.role == 'superadmin');
      allow list, update, delete: if admin();
    }
    match /inventory/{entry} { allow read, write: if admin() || inventoryEmployee(); }
    match /shapes/{entry} { allow read: if activeEmployee() || admin(); allow write: if admin() || inventoryEmployee(); }
    match /settings/{entry} { allow read: if activeEmployee() || admin(); allow write: if admin(); }
    match /parties/{party} { allow read: if activeEmployee() || admin(); allow write: if admin(); }
    match /activityLog/{entry} { allow read: if admin(); allow create: if admin() || (inventoryEmployee() && request.resource.data.actor.uid == request.auth.uid); allow update, delete: if false; }
    match /activityLogFirstLogins/{entry} { allow get, create: if admin() || (activeEmployee() && request.resource.data.actor.uid == request.auth.uid); allow update, delete: if false; }
  }
}

